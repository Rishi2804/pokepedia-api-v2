{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "max_result_window": 1000,
      "max_ngram_diff": 7
    },
    "analysis": {
      "char_filter": {
        "strip_apostrophes": {
          "type": "pattern_replace",
          "pattern": "['’ʼ`]",
          "replacement": ""
        }
      },
      "filter": {
        "name_edge_ngram": { "type": "edge_ngram", "min_gram": 2, "max_gram": 20,
                             "preserve_original": true },
        "name_infix_ngram": { "type": "ngram", "min_gram": 3, "max_gram": 10 },
        "ac_truncate":     { "type": "truncate", "length": 20 },
        "infix_truncate":  { "type": "truncate", "length": 10 },
        "english_possessive": { "type": "stemmer", "language": "possessive_english" },
        "english_stop":       { "type": "stop",    "stopwords": "_english_" },
        "english_stemmer":    { "type": "stemmer", "language": "english" }
      },
      "normalizer": {
        "lc": { "type": "custom", "filter": ["lowercase", "asciifolding"] }
      },
      "analyzer": {
        "name_std": {
          "type": "custom", "char_filter": ["strip_apostrophes"],
          "tokenizer": "standard", "filter": ["lowercase", "asciifolding"]
        },
        "name_ac_index": {
          "type": "custom", "char_filter": ["strip_apostrophes"],
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "name_edge_ngram"]
        },
        "name_ac_search": {
          "type": "custom", "char_filter": ["strip_apostrophes"],
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "ac_truncate"]
        },
        "name_infix_index": {
          "type": "custom", "char_filter": ["strip_apostrophes"],
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "name_infix_ngram"]
        },
        "name_infix_search": {
          "type": "custom", "char_filter": ["strip_apostrophes"],
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "infix_truncate"]
        },
        "description_en": {
          "type": "custom", "char_filter": ["strip_apostrophes"],
          "tokenizer": "standard",
          "filter": ["english_possessive", "lowercase", "english_stop",
                     "english_stemmer", "asciifolding"]
        }
      }
    }
  },

  "mappings": {
    "dynamic": "strict",
    "properties": {
      "type":      { "type": "keyword" },
      "entity_id": { "type": "integer" },
      "gen":       { "type": "byte" },

      "slug": {
        "type": "keyword", "normalizer": "lc",
        "fields": {
          "text": { "type": "text", "analyzer": "name_std" },
          "ac":   { "type": "text", "analyzer": "name_ac_index",
                    "search_analyzer": "name_ac_search" }
        }
      },

      "name": {
        "type": "text", "analyzer": "name_std",
        "fields": {
          "kw":    { "type": "keyword", "normalizer": "lc", "ignore_above": 128 },
          "ac":    { "type": "text", "analyzer": "name_ac_index",
                     "search_analyzer": "name_ac_search" },
          "infix": { "type": "text", "analyzer": "name_infix_index",
                     "search_analyzer": "name_infix_search" }
        }
      },

      "aliases": {
        "type": "text", "analyzer": "name_std",
        "fields": {
          "ac":    { "type": "text", "analyzer": "name_ac_index",
                     "search_analyzer": "name_ac_search" },
          "infix": { "type": "text", "analyzer": "name_infix_index",
                     "search_analyzer": "name_infix_search" }
        }
      },

      "description": { "type": "text", "analyzer": "description_en" },
      "effect":      { "type": "text", "analyzer": "description_en" },

      "popularity":  { "type": "rank_feature", "positive_score_impact": true },

      "meta": {
        "type": "object", "dynamic": "strict",
        "properties": {
          "type1": { "type": "keyword" }, "type2": { "type": "keyword" },
          "species_id": { "type": "integer" }, "dex_number": { "type": "integer" },
          "move_type": { "type": "keyword" }, "move_class": { "type": "keyword" },
          "power": { "type": "short" }, "accuracy": { "type": "short" },
          "pp": { "type": "short" }
        }
      }
    }
  }
}
